#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Keep `php artisan test` isolated from the local application's cached config.
// The PHPUnit process also sets this in phpunit.xml, but the Artisan parent
// process boots Laravel before PHPUnit reads that file.
$argv = $_SERVER['argv'] ?? [];
if (in_array('test', array_slice($argv, 1), true)) {
    $testingEnv = [
        'APP_ENV' => 'testing',
        'APP_CONFIG_CACHE' => 'bootstrap/cache/config.testing.php',
        'DB_CONNECTION' => 'sqlite',
        'DB_DATABASE' => ':memory:',
    ];

    foreach ($testingEnv as $key => $value) {
        putenv($key.'='.$value);
        $_ENV[$key] = $value;
        $_SERVER[$key] = $value;
    }
}

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$status = $app->handleCommand(new ArgvInput);

exit($status);
